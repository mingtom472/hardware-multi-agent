# Hardware Multi-Agent MVP — copy to repository-root .env.
# Keep populated secrets out of Git. Mock mode needs no API keys.
HW_MODEL_MODE=mock
HW_DATA_DIR=.local/data

# No fixed product per-file size or total byte quota by default.
# Optional administrator/resource policy caps (omit these to leave unset):
# HW_MAX_UPLOAD_BYTES=26214400
# HW_MAX_STORAGE_BYTES=10737418240
# Keep at least 16 MiB free on the actual destination filesystem.
HW_STORAGE_RESERVE_BYTES=16777216
HW_MAX_STORED_FILES=1000
HW_UPLOAD_CHUNK_BYTES=65536
HW_MAX_FILES_PER_TASK=8
HW_MAX_ACTIVE_TASKS=4
HW_MAX_TASKS=200
# HW_WORKFLOW_PATH=/absolute/path/to/workflow.json

# Local USD accounting policy. Vendor invoices may differ from estimates.
HW_DAILY_BUDGET_USD=10
HW_MONTHLY_BUDGET_USD=100
HW_DEFAULT_TASK_BUDGET_USD=1
HW_ESTIMATED_CALL_COST_USD=0.01

# Backend-only credentials. Real use additionally requires an exact configured
# model ID, explicit connection testing and vendor-specific capability checks.
HW_QWEN_API_KEY=
HW_OPENAI_API_KEY=
HW_CLAUDE_API_KEY=
HW_MOONSHOT_API_KEY=
HW_DEEPSEEK_API_KEY=
# Additional reserved adapters, not part of the five live-text implementations.
HW_DOUBAO_API_KEY=
HW_GLM_API_KEY=

# Streamlit server-to-server API address and browser direct-upload address.
# Startup scripts set defaults from BACKEND_PORT; export overrides if necessary.
# HW_API_URL=http://127.0.0.1:8000
# HW_BROWSER_API_URL=http://127.0.0.1:8000
# Next.js server-to-server destination (build-time rewrites + runtime upload).
# BACKEND_URL=http://127.0.0.1:8000

# Reserved infrastructure. Setting these does not activate an integration.
HW_DATABASE_URL=
HW_REDIS_URL=
HW_OBJECT_STORAGE_ENDPOINT=
HW_OBJECT_STORAGE_BUCKET=
